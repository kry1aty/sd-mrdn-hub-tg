# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGhIJKlmNoPQRsTUVwxyZ

# Ваш личный ID в Telegram (число) — для подробных карточек с ссылками
TELEGRAM_USER_CHAT_ID=481234567

# ID супергруппы (отрицательное число, начинается с -100...)
TELEGRAM_GROUP_CHAT_ID=-1002345678901

# ID ветки (топика/темы) внутри супергруппы для релизов (число)
TELEGRAM_TOPIC_ID=42

# Секретный токен для верификации вебхука из GitLab (задаётся в настройках Webhook в GitLab)
GITLAB_WEBHOOK_SECRET=sd_mrdn_gitlab_secret_key_123

# Секретный токен для отправки событий из ядра SD.MRDN (/sd-event)
SD_MRDN_API_SECRET=sd_mrdn_core_event_secret_key_456
